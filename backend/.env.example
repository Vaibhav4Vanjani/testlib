# Environment Mode (development | production | test)
NODE_ENV=production

# Server Port (default: 5000)
PORT=5000

# MongoDB Connection URI (Local or Remote MongoDB / Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nextlib_db

# JWT Secrets (Must be strong 32+ char secrets in production)
JWT_ACCESS_SECRET=replace_with_a_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_super_secret_jwt_refresh_key_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage Provider & Upload Directory
STORAGE_PROVIDER=local
# Persistent directory outside Git repo for production uploads
UPLOAD_DIR=/var/www/data/uploads
LOCAL_UPLOAD_DIR=./public/uploads

# CORS Allowed Origins (Comma-separated URLs)
ALLOWED_ORIGINS=https://nextlib.in,https://www.nextlib.in,http://localhost:5173
